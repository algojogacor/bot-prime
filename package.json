{
  "name": "omak",
  "version": "0.1.0",
  "description": "Omak — AI companion bot for WhatsApp groups (Baileys v7 + Turso + Koyeb)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "dataset:verify": "node scripts/dataset/verify.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^18.0.10",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "@whiskeysockets/baileys@7.0.0-rc14": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true
  }
}
