# Omak configuration. Copy to .env and fill in. NEVER commit .env.

# --- Runtime ---
# development | production | test
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Koyeb always injects PORT for Web Services; this is the local fallback.
PORT=3000

# --- Database (Turso) ---
# Remote: libsql://<db>-<org>.turso.io
# Local/dev/test: file:./data/omak.db
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# Required for remote URLs; omit for file: URLs.
TURSO_AUTH_TOKEN=

# --- Baileys auth encryption ---
# 32 random bytes, base64. Generate: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=

# --- AI provider ---
# openai | anthropic | gemini | openrouter
AI_PROVIDER=openrouter
AI_API_KEY=
# Optional overrides.
AI_BASE_URL=
# Model id. openai defaults to gpt-4o-mini, anthropic to claude-3-5-haiku-latest,
# gemini to gemini-2.0-flash; openrouter REQUIRES an explicit model id.
AI_MODEL=
# Providers tried in order when the primary fails, e.g. openai,gemini
AI_FALLBACK_ORDER=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=400

# --- Access control (comma-separated WhatsApp JIDs) ---
# e.g. 6281234567890@s.whatsapp.net
OMAK_ADMIN_JIDS=
# Empty = respond in any group the bot has joined.
OMAK_ALLOWED_GROUP_JIDS=

# --- Pairing (first run only) ---
# Digits only, no +. When set, a pairing code is requested for this number
# instead of waiting for a QR scan.
OMAK_PAIRING_NUMBER=

# --- Behavior limits ---
# Quiet hours in UTC. 16-0 == 23:00-07:00 WIB (UTC+7).
OMAK_QUIET_HOURS_UTC=16-0
OMAK_MAX_DAILY_AI_CALLS=300

# --- Social pacing ---
# 0..1 chance to chime in on a burst not addressed to the bot.
OMAK_AMBIENT_REPLY_RATE=0.04
OMAK_MAX_REPLIES_PER_HOUR=12
OMAK_MIN_REPLY_GAP_MS=8000
OMAK_MAX_STARTERS_PER_DAY=2
# Comma-separated lowercase nicknames the group can call the bot.
OMAK_MENTION_TOKENS=omak,oma,mak

# --- Community dataset (read-only retrieval over data/seed) ---
# Seed artifacts are committed and produced by scripts/dataset (see data/source).
OMAK_SEED_DIR=data/seed
# Max archived messages injected into one prompt, and its ~token budget.
OMAK_ARCHIVE_MAX_HITS=6
OMAK_ARCHIVE_BUDGET_TOKENS=900

# --- Provider ecosystem (Bot Prime's OWN credentials; comma lists rotate on 401/403/429) ---
# Primary provider: openai (any OpenAI-compatible gateway via AI_BASE_URL), gemini, anthropic, openrouter
# Groq gateway example: AI_PROVIDER=openai + AI_BASE_URL=https://api.groq.com/openai/v1 + AI_MODEL=openai/gpt-oss-120b
AI_GROQ_KEYS=
AI_GEMINI_KEYS=
AI_NVIDIA_KEYS=
AI_DEEPSEEK_KEYS=
AI_COHERE_KEYS=
AI_MISTRAL_KEYS=
AI_OLLAMA_KEYS=
# Fallback order after the primary (Gojiha-aligned chat order by default):
# AI_FALLBACK_ORDER=gemini,nvidia,mistral,deepseek,cohere
# Output policy: provider-native by default; optional generous guard, never a low clip cap.
# AI_MAX_OUTPUT_TOKENS=
AI_CONTINUATION_MAX_TOKENS=4096
